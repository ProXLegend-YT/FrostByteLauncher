<?xml version="1.0" encoding="utf-8"?>
<!-- Back navigation mirrors forward: the returning screen fades + slides down into place too,
     so the whole app uses one consistent "fade & slide down" language in both directions. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:fromYDelta="-4%"
        android:toYDelta="0"
        android:duration="280"
        android:interpolator="@android:anim/decelerate_interpolator" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="280"
        android:interpolator="@android:anim/decelerate_interpolator" />
</set>
