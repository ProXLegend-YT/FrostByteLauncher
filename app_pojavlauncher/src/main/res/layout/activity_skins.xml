<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/frostbyte_space_bg"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/skins_back_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/frostbyte_icon_button_bg"
                    android:src="@drawable/ic_px_arrow_left"
                    app:tint="@color/frostbyte_accent"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/skins_title"
                    android:textColor="@color/frostbyte_text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/skins_account_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/frostbyte_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                tools:text="Signed in with a Microsoft account — skins you apply will upload to Mojang" />

            <!-- Real 3D player model, showing whichever account is currently selected's actual skin -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/frostbyte_dropdown_panel_bg">

                <com.frostbyte.launcher.skins.SkinModelView
                    android:id="@+id/skins_model_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/skins_model_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Upload from gallery -->
            <Button
                android:id="@+id/skins_upload_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/frostbyte_button_primary"
                android:text="@string/skins_upload_from_gallery"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Username lookup, still needed as the only way to import someone else's skin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/skins_username_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/frostbyte_input_field"
                    android:hint="@string/skins_username_hint"
                    android:textColorHint="@color/frostbyte_text_secondary"
                    android:textColor="@color/frostbyte_text_primary"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <Button
                    android:id="@+id/skins_username_search_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/frostbyte_button_secondary"
                    android:text="@string/skins_search"
                    android:textAllCaps="false"
                    android:textColor="@color/frostbyte_accent"
                    android:paddingHorizontal="20dp" />
            </LinearLayout>

            <!-- Capes section (Microsoft accounts only) -->
            <LinearLayout
                android:id="@+id/skins_capes_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/skins_capes_title"
                    android:textColor="@color/frostbyte_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/skins_capes_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/frostbyte_dropdown_panel_bg" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/skins_loading_indicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
