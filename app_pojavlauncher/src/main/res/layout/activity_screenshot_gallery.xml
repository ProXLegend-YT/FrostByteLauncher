<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/frostbyte_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/screenshot_gallery_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/frostbyte_icon_button_bg"
            android:src="@drawable/ic_px_arrow_left"
            app:tint="@color/frostbyte_accent"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/screenshot_gallery_title"
            android:textColor="@color/frostbyte_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/screenshot_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:verticalSpacing="2dp"
            android:horizontalSpacing="2dp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/screenshot_gallery_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/frostbyte_text_secondary"
            android:textSize="14sp"
            android:padding="32dp"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
