<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="android:textSize">@dimen/_12ssp</item>

    </style>

    <!-- Applied to launcher UI screens (home, profiles, settings) only -
         NOT the base AppTheme, so GameActivity keeps a clean render surface
         with no wallpaper behind it during gameplay/loading. -->
    <style name="AppTheme.Launcher">
        <item name="android:windowBackground">@color/frostbyte_window_fallback</item>
        <item name="android:windowAnimationStyle">@style/FrostByteWindowAnimation</item>
    </style>

    <style name="FrostByteWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/frostbyte_window_enter</item>
        <item name="android:windowExitAnimation">@anim/frostbyte_window_exit</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/frostbyte_button_secondary</item>
        <item name="android:textColor">@color/frostbyte_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginVertical">5dp</item>
    </style>

    <!-- FrostByte typography -->
    <style name="Frostbyte.Text.Title" parent="">
        <item name="android:textColor">@color/frostbyte_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Frostbyte.Text.Body" parent="">
        <item name="android:textColor">@color/frostbyte_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Frostbyte.Text.Caption" parent="">
        <item name="android:textColor">@color/frostbyte_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- FrostByte glass card container, for use on any screen -->
    <style name="Frostbyte.Card" parent="">
        <item name="android:background">@drawable/frostbyte_card_bg</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Primary action button (Play, Confirm, etc.) -->
    <style name="Frostbyte.Button.Primary" parent="">
        <item name="android:background">@drawable/frostbyte_button_primary</item>
        <item name="android:textColor">@color/frostbyte_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">@color/frostbyte_card_stroke</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
