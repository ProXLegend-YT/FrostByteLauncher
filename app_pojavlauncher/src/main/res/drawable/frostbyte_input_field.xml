<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/frostbyte_surface_2" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/frostbyte_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/frostbyte_surface_1" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/frostbyte_card_stroke" />
        </shape>
    </item>
</selector>
